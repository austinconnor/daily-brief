# Postgres
POSTGRES_USER=miniflux
POSTGRES_PASSWORD=change_me
POSTGRES_DB=miniflux

# Miniflux bootstrap admin account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
MINIFLUX_BASE_URL=http://UNRAID_IP:8081

# ai-daily-brief runtime
TZ=America/New_York
MINIFLUX_URL=http://miniflux:8080
MINIFLUX_API_TOKEN=replace_with_miniflux_api_token
GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
DISCORD_USERNAME=AI Morning Brief
RUN_AT_LOCAL_TIME=08:00
LOOKBACK_HOURS=24
MAX_ITEMS=60
